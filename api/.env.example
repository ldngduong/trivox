# ==========================================
# TRIVOX — 3D CAD Studio & AI Agent SaaS
# ==========================================

PORT=3001
FRONTEND_URL=http://127.0.0.1:5173
PYTHON_WORKER_URL=http://127.0.0.1:8001

# 1. Database (PostgreSQL + TypeORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trivox?schema=app

# 2. Authentication & Admin Seed
JWT_SECRET=trivox-prod-jwt-secret-key-change-in-production-2026
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ADMIN_SEED_EMAIL=admin@trivox.io
ADMIN_SEED_PASSWORD=Admin@Trivox2026
ADMIN_SEED_NAME=Trivox Admin

# 3. Cloudflare R2 Object Storage (S3 Compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=trivox-assets
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# 4. AI Providers (Groq Vision + DeepSeek Harness)
GROQ_API_KEY=gsk_your_groq_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

DEEPSEEK_API_KEY=sk-your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
