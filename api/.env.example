# ==========================================
# TRIVOX — 3D CAD Studio & AI Agent SaaS
# ==========================================

PORT=3001
FRONTEND_URL=http://127.0.0.1:5173
PYTHON_WORKER_URL=http://127.0.0.1:8001

# 1. Database (PostgreSQL + TypeORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trivox?schema=app

# 2. Authentication, Google OAuth 2.0 & Admin Seed
JWT_SECRET=trivox-prod-jwt-secret-key-change-in-production-2026
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:5173/api/auth/google/callback

ADMIN_SEED_EMAIL=admin@trivox.io
ADMIN_SEED_PASSWORD=Admin@Trivox2026
ADMIN_SEED_NAME=Trivox Admin

# 3. Cloudflare R2 Object Storage (S3 Compatible)
# Use an R2 API Token with "Admin Read & Write" permission to auto-create the bucket on startup.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=trivox-assets
R2_PUBLIC_URL=

# 4. Groq AI (Vision + Agentic Code Harness)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CODE_MODEL=openai/gpt-oss-120b
